{
  "name": "wasm-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run sync-html.ts --check && bun run build.ts",
    "check:html": "bun run sync-html.ts --check",
    "dev": "bun --hot src/index.ts",
    "preview": "NODE_ENV=production bun src/preview.ts",
    "preview:subpath": "NODE_ENV=production bun src/preview-subpath.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "sync:html": "bun run sync-html.ts",
    "test": "bun test tests/unit",
    "test:all": "bun run test:unit && bun run build && bun run test:dist && bun run test:e2e",
    "test:dist": "bun test tests/dist",
    "test:e2e": "playwright test",
    "test:e2e:subpath": "playwright test tests/e2e/subpath.spec.ts",
    "test:unit": "bun test tests/unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@runno/runtime": "^0.10.0",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "monaco-editor": "^0.57.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
