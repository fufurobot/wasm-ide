{
  "name": "@fufurobot/wasm-ide",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "bun run sync-html.ts --check && bun run build.ts",
    "build-lib:fix-types": "bun run fix-lib-types.ts",
    "build:lib": "bun run build-lib.ts && bunx tsc -p tsconfig.lib.json && bun run build-lib:fix-types",
    "check:html": "bun run sync-html.ts --check",
    "dev": "bun --hot src/index.ts",
    "pack:lib": "bun run build:lib && npm pack --dry-run",
    "preview": "NODE_ENV=production bun src/preview.ts",
    "preview:subpath": "NODE_ENV=production bun src/preview-subpath.ts",
    "serve:fixtures": "NODE_ENV=production bun tests/fixtures/serve.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "sync:html": "bun run sync-html.ts",
    "test": "bun test tests/unit",
    "test:all": "bun run test:unit && bun run build && bun run test:dist && bun run test:e2e",
    "test:dist": "bun test tests/dist",
    "test:e2e": "playwright test",
    "test:e2e:subpath": "playwright test tests/e2e/subpath.spec.ts",
    "test:lib": "playwright test tests/e2e/library.spec.ts",
    "test:unit": "bun test tests/unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@runno/runtime": "^0.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-plugin-tailwind": "^0.1.2",
    "monaco-editor": "^0.57.0",
    "playwright": "^1.64.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "description": "A WebAssembly IDE built on Runno and Monaco, for React and plain-JS embedding.",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fufurobot/wasm-ide.git"
  },
  "homepage": "https://fufurobot.github.io/wasm-ide/",
  "bugs": {
    "url": "https://github.com/fufurobot/wasm-ide/issues"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "ide",
    "monaco",
    "runno",
    "editor",
    "playground",
    "react"
  ],
  "main": "./dist-lib/index.cjs",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "require": "./dist-lib/index.cjs"
    },
    "./vanilla": {
      "types": "./dist-lib/vanilla.d.ts",
      "import": "./dist-lib/vanilla.js",
      "require": "./dist-lib/vanilla.cjs"
    },
    "./coi-serviceworker.js": "./dist-lib/coi-serviceworker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
