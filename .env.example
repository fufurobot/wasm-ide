# wasm-ide environment template.
#
# Copy to `.env` and fill in locally. `.env` is git-ignored and MUST NEVER be
# committed. This file is documentation only: every sensitive value below is
# intentionally erased.

# Fine-grained GitHub personal access token, used exclusively by
# `tools/gh.py` to open issues/PRs and read CI status from the command line.
#
# Required scopes for this repository:
#   - Contents:      read and write (push branches, configure Dependabot)
#   - Issues:        read and write
#   - Pull requests: read and write
#   - Actions:       read (CI status)
#   - Workflows:     read and write (only if CI workflow files are pushed by the API)
#
# IMPORTANT: this variable is deliberately NOT prefixed with `BUN_PUBLIC_`.
# `bunfig.toml` restricts the frontend bundle to `BUN_PUBLIC_*`, so anything
# named here can never be inlined into the browser build.
DEEPSEEK_GITHUB_TOKEN=

# Repository the tooling talks to, in `owner/name` form. Not a secret.
GITHUB_REPOSITORY=
